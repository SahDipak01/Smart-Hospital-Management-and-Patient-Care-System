# ==============================================================================
# SMART HOSPITAL MANAGEMENT & PATIENT CARE SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and adjust variables as per your environment deployment.

PORT=5000
NODE_ENV=development

# JSON Web Token Secret & Expiration
JWT_SECRET=your_secure_random_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# MongoDB Connection URI (supports local standalone, replica set, Atlas, or embedded fallback)
MONGODB_URI=mongodb://127.0.0.1:27017/smart_hospital_db

# Frontend Client Base URL (used for CORS origin configuration)
CLIENT_URL=http://localhost:5173
